// Merge into ~/.openclaw/openclaw.json. Set MISSION_CONTROL_MCP_TOKEN in the gateway's environment.
{
  "plugins": {
    "slots": { "memory": "mission-control" },
    "entries": {
      "mission-control": {
        "enabled": true,
        "config": {
          "token": "${MISSION_CONTROL_MCP_TOKEN}",
          "agentId": "openclaw",
          "autoRecall": true,
          "autoCapture": true
        }
      }
    }
  }
}
