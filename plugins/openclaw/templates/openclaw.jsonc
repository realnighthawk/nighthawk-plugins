// Merge into ~/.openclaw/openclaw.json. Set NIGHTHAWK_MCP_TOKEN in the gateway's environment.
{
  "plugins": {
    "slots": { "memory": "nighthawk-memory" },
    "entries": {
      "nighthawk-memory": {
        "enabled": true,
        "config": {
          "token": "${NIGHTHAWK_MCP_TOKEN}",
          "agentId": "openclaw",
          "autoRecall": true,
          "autoCapture": true
        }
      }
    }
  }
}
