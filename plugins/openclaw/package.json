{
  "name": "mission-control",
  "version": "0.2.0",
  "description": "Mission Control Hippocampus memory for OpenClaw (MCP over HTTP + lifecycle hooks)",
  "type": "module",
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "config.ts",
    "client.ts",
    "recall.ts",
    "capture.ts",
    "format.ts",
    "session-state.ts",
    "openclaw.plugin.json",
    "README.md",
    "templates/",
    "assets/"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.3.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --loader ./test/ts-hooks.mjs --test test/*.test.js"
  }
}
