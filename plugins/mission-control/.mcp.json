{
  "mcpServers": {
    "finance": {
      "type": "http",
      "url": "${MISSION_CONTROL_FINANCE_URL:-https://api.nighthawklabs.org/finance/mcp}",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      },
      "headers": {
        "X-Nighthawk-Verified-User": "${MISSION_CONTROL_OWNER_SUB:-}"
      }
    },
    "maps": {
      "type": "http",
      "url": "${MISSION_CONTROL_MAPS_URL:-https://api.nighthawklabs.org/maps/mcp}",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      },
      "headers": {
        "X-Nighthawk-Verified-User": "${MISSION_CONTROL_OWNER_SUB:-}"
      }
    },
    "life": {
      "type": "http",
      "url": "${MISSION_CONTROL_LIFE_URL:-https://api.nighthawklabs.org/life/mcp}",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      },
      "headers": {
        "X-Nighthawk-Verified-User": "${MISSION_CONTROL_OWNER_SUB:-}",
        "X-Agent-ID": "${MISSION_CONTROL_AGENT_ID:-}"
      }
    },
    "retro": {
      "type": "http",
      "url": "${MISSION_CONTROL_RETRO_URL:-https://api.nighthawklabs.org/retro/mcp}",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      },
      "headers": {
        "X-Nighthawk-Verified-User": "${MISSION_CONTROL_OWNER_SUB:-}"
      }
    },
    "health": {
      "type": "http",
      "url": "${MISSION_CONTROL_HEALTH_URL:-http://127.0.0.1:8080/mcp}"
    },
    "fpl": {
      "type": "http",
      "url": "${MISSION_CONTROL_FPL_URL:-http://127.0.0.1:8000/mcp}"
    },
    "fpl_intelligence": {
      "type": "http",
      "url": "${MISSION_CONTROL_FPL_INTELLIGENCE_URL:-http://127.0.0.1:8001/mcp}"
    },
    "reddit": {
      "type": "http",
      "url": "${MISSION_CONTROL_REDDIT_URL:-http://127.0.0.1:3000/mcp}"
    },
    "auto_browser": {
      "type": "http",
      "url": "${MISSION_CONTROL_AUTO_BROWSER_URL:-http://127.0.0.1:8000/mcp}",
      "headers": {
        "Authorization": "Bearer ${MISSION_CONTROL_AUTO_BROWSER_TOKEN:-}",
        "Host": "${MISSION_CONTROL_AUTO_BROWSER_HOST:-auto-browser}"
      }
    },
    "hippocampus": {
      "type": "http",
      "url": "${MISSION_CONTROL_MEMORY_URL:-https://api.nighthawklabs.org/memory/mcp}",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      },
      "headers": {
        "X-Agent-ID": "${MISSION_CONTROL_AGENT_ID}",
        "X-API-Key": "${MISSION_CONTROL_MEMORY_KEY:-}"
      }
    }
  }
}
