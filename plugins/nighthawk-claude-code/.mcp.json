{
  "mcpServers": {
    "hippocampus": {
      "type": "http",
      "url": "https://api.nighthawklabs.org/hub/mcp",
      "oauth": {
        "scopes": "openid profile email",
        "authServerMetadataUrl": "https://clerk.nighthawklabs.org/.well-known/oauth-authorization-server"
      }
    },
    "memory": {
      "type": "http",
      "url": "${NIGHTHAWK_MCP_URL:-https://agent-memory.nighthawklabs.org/mcp}",
      "headers": {
        "X-API-Key": "${NIGHTHAWK_API_KEY:-}"
      }
    }
  }
}
