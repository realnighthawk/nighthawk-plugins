#!/bin/sh
# mc: run omp or Claude Code with your Mission Control workstation's browser and memory attached.
#
#   mc omp [omp arguments]   sign in if needed, connect the workstation's browser, start omp
#   mc claude [claude args]  the same for Claude Code: browser as the `browser` MCP, memory recalled at start and retained at end by the plugin's hooks
#   mc login                 sign in again (a link lasts 12 hours)
#   mc status                say whether the workstation is reachable
#
# It leans on existing tools: curl, python3 (a one-shot listener for the sign-in), websocat (WebSocket to a local port) and omp's own --config.
# The workstation's browser appears to omp as a local one, at a free port on 127.0.0.1. Nothing is installed besides this file and websocat.
set -eu

ROUTER=${MC_ROUTER_URL:-https://api.nighthawklabs.org}
WEB=${MC_WEB_URL:-https://mission-control.nighthawklabs.org}
DIR=${XDG_CONFIG_HOME:-$HOME/.config}/mc
TOKEN_FILE=$DIR/token
WS_URL=$(printf '%s' "$ROUTER" | sed -e 's#^https#wss#' -e 's#^http#ws#')/workstation/cdp

say() { printf 'mc: %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || { say "$1 is needed. $2"; exit 1; }; }
free_port() { python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1])'; }

# ok = the router accepted the token and reached the workstation; login = the token is missing or expired; down = no workstation is running.
probe() {
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "Authorization: Bearer $1" "$ROUTER/workstation/cdp" || echo 000)
  case $code in
    400) echo ok ;;
    401) echo login ;;
    502) echo down ;;
    *) echo "error $code" ;;
  esac
}

# Sign in through the browser: the Mission Control page, once you confirm, sends the token to a listener on this machine's loopback.
login() {
  need python3 "It runs the one-time sign-in listener."
  mkdir -p "$DIR" && chmod 700 "$DIR"
  port=$(free_port)
  state=$(python3 -c 'import secrets;print(secrets.token_urlsafe(16))')
  out=$(mktemp)
  MC_STATE=$state MC_OUT=$out python3 - "$port" <<'PY' &
import http.server, os, sys, time, urllib.parse
state, out = os.environ["MC_STATE"], os.environ["MC_OUT"]
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.urlparse(self.path)
        p = urllib.parse.parse_qs(q.query)
        ok = q.path == "/callback" and p.get("state") == [state] and p.get("token")
        if ok:
            fd = os.open(out, os.O_WRONLY | os.O_TRUNC, 0o600)
            os.write(fd, p["token"][0].encode()); os.close(fd)
        self.send_response(200 if ok else 400)
        self.send_header("Content-Type", "text/plain; charset=utf-8"); self.end_headers()
        self.wfile.write(b"Connected. You can close this tab." if ok else b"Not the sign-in mc is waiting for.")
    def log_message(self, *a): pass
srv = http.server.HTTPServer(("127.0.0.1", int(sys.argv[1])), H)
srv.timeout = 5
end = time.time() + 180
while time.time() < end and not os.path.getsize(out):
    srv.handle_request()
PY
  listener=$!
  url="$WEB/connect?port=$port&state=$state"
  say "opening $url"
  (open "$url" || xdg-open "$url") >/dev/null 2>&1 || say "open that address in your browser"
  wait "$listener" || true
  if [ ! -s "$out" ]; then rm -f "$out"; say "no sign-in came back in 3 minutes"; exit 1; fi
  mv "$out" "$TOKEN_FILE" && chmod 600 "$TOKEN_FILE"
  say "signed in"
}

# Make sure there is a token that works. Sets TOKEN and STATE (ok or down).
ensure() {
  TOKEN=$(cat "$TOKEN_FILE" 2>/dev/null || true)
  STATE=$([ -n "$TOKEN" ] && probe "$TOKEN" || echo login)
  if [ "$STATE" = login ]; then
    login
    TOKEN=$(cat "$TOKEN_FILE")
    STATE=$(probe "$TOKEN")
  fi
  case $STATE in ok | down) ;; *) say "the router answered unexpectedly ($STATE)"; exit 1 ;; esac
}

# Tell Mission Control this session exists, so the Agents page lists it. One beat now and every 30 seconds; a last "offline" on exit. It reports where omp runs
# (machine, folder, version), not what is said in it, and a failed beat is ignored: it never gets in omp's way.
beat() {
  body=$(printf '{"session_id":"%s","host":"%s","state":"%s","now":"Running in %s","cwd":"%s","version":"%s"}' \
    "$SESSION" "$HOST" "$1" "$(printf '%s' "$PWD" | sed -e "s#^$HOME#~#" -e 's/["\\]/_/g')" "$(printf '%s' "$PWD" | sed 's/["\\]/_/g')" "$OMP_VERSION")
  curl -s -o /dev/null --max-time 10 -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' -d "$body" "$ROUTER/local-agents/heartbeat" || true
}
start_beats() {
  SESSION=$(python3 -c 'import secrets;print(secrets.token_hex(8))' 2>/dev/null || date +%s%N)
  HOST=$(hostname -s 2>/dev/null | tr -c 'A-Za-z0-9._-\n' '_' || echo unknown)
  OMP_VERSION=$("${AGENT_CMD:-omp}" --version 2>/dev/null | head -1 | tr -c 'A-Za-z0-9._ -\n' '_' || true)
  ( while :; do beat idle; sleep 30; done ) &
  beater=$!
}
stop_beats() {
  if [ -n "${beater:-}" ]; then kill "$beater" 2>/dev/null || true; beat offline; fi
}

cmd=${1:-}
case $cmd in
  login) login ;;
  status)
    ensure
    if [ "$STATE" = ok ]; then say "connected: your workstation is reachable"; else say "your workstation is not running: create it at $WEB/workstation"; fi
    ;;
  omp)
    shift
    need omp "Install oh-my-pi first."
    ensure
    tmp=$(mktemp -d)
    trap 'stop_beats; kill "${tunnel:-}" 2>/dev/null || true; rm -rf "$tmp"' EXIT INT TERM
    start_beats
    # Memory is oh-my-pi's own (its hindsight backend) on your workspace's memory server, through the router: recalled at the start of a turn, retained at the end.
    # The token goes in the environment, not in the file.
    printf 'memory:\n  backend: hindsight\nhindsight:\n  apiUrl: %s/memory\n  bankId: ohmypi\n  scoping: global\n  mentalModelsEnabled: false\n  mentalModelAutoSeed: false\n' "$ROUTER" >"$tmp/omp.yml"
    export HINDSIGHT_API_TOKEN=$TOKEN MISSION_CONTROL_NATIVE_MEMORY=1
    if [ "$STATE" = down ]; then
      say "your workstation is not running, so omp starts without it. Create it at $WEB/workstation, then run mc omp again."
      omp --config "$tmp/omp.yml" "$@"
      exit $?
    fi
    need websocat "Install it: brew install websocat (macOS), or see https://github.com/vi/websocat"
    port=$(free_port)
    printf 'browser:\n  cdpUrl: http://127.0.0.1:%s\n' "$port" >>"$tmp/omp.yml"
    # -H takes every argument after it as a header, so it goes last.
    websocat -b "tcp-l:127.0.0.1:$port" "$WS_URL" -H "Authorization: Bearer $TOKEN" >/dev/null 2>&1 &
    tunnel=$!
    say "your workstation's browser is attached (127.0.0.1:$port)"
    omp --config "$tmp/omp.yml" "$@"
    ;;
  claude)
    shift
    need claude "Install Claude Code first."
    ensure
    AGENT_CMD=claude
    tmp=$(mktemp -d)
    trap 'stop_beats; kill "${tunnel:-}" 2>/dev/null || true; rm -rf "$tmp"' EXIT INT TERM
    start_beats
    # Claude Code has no memory or browser slot, so the plugin's hooks do the memory over the router's REST API (they read these three), and the browser is an MCP.
    export MC_MEMORY_URL=$ROUTER/memory MC_MEMORY_TOKEN=$TOKEN MC_MEMORY_BANK=${MC_MEMORY_BANK:-claude-code}
    if [ "$STATE" = down ]; then
      say "your workstation is not running, so Claude Code starts without a browser. Create it at $WEB/workstation, then run mc claude again."
      claude "$@"
      exit $?
    fi
    need websocat "Install it: brew install websocat (macOS), or see https://github.com/vi/websocat"
    port=$(free_port)
    websocat -b "tcp-l:127.0.0.1:$port" "$WS_URL" -H "Authorization: Bearer $TOKEN" >/dev/null 2>&1 &
    tunnel=$!
    printf '{"mcpServers":{"browser":{"command":"npx","args":["-y","@playwright/mcp@latest","--cdp-endpoint","http://127.0.0.1:%s"]}}}' "$port" >"$tmp/mcp.json"
    say "your workstation's browser is attached as the browser MCP (127.0.0.1:$port)"
    claude --mcp-config "$tmp/mcp.json" --append-system-prompt "Browser work uses the browser MCP tools. They drive the person's own workstation browser, which keeps their saved logins. There is no other browser; if it cannot connect, say so once." "$@"
    ;;
  *)
    say "usage: mc omp [omp arguments] | mc claude [claude arguments] | mc login | mc status"
    exit 2
    ;;
esac
